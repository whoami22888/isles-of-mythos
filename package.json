{
  "name": "isles-of-mythos",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "npm run dev -w client",
    "dev:server": "npm run dev -w server",
    "build": "npm run build -w client && npm run build -w server",
    "typecheck": "npm run typecheck -w client && npm run typecheck -w server",
    "test": "npm run test -w client && npm run test -w server",
    "lint": "npm run lint:eslint",
    "migrate:up": "npm run migrate:up -w server",
    "migrate:down": "npm run migrate:down -w server",
    "lint:eslint": "eslint client/src server/src --max-warnings=0",
    "lint:ts": "npm run typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "typescript-eslint": "^8.0.0"
  }
}
