{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Isles of Mythos third-party vendor lock",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "assets"
  ],
  "properties": {
    "$schema": {
      "const": "./schemas/vendor-lock.schema.json"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "license",
          "license_path",
          "source_url"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "license": {
            "enum": [
              "CC0-1.0",
              "CC-BY-4.0",
              "CC-BY-SA-4.0",
              "MIT",
              "Apache-2.0",
              "OFL-1.1"
            ]
          },
          "license_path": {
            "type": "string",
            "minLength": 1
          },
          "source_url": {
            "type": "string",
            "pattern": "^https://"
          },
          "vendor": {
            "type": "string",
            "minLength": 1
          },
          "source_revision": {
            "type": "string",
            "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
          },
          "pack_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "path": {
                  "pattern": "^assets-src/"
                }
              },
              "required": [
                "path"
              ]
            },
            "then": {
              "required": [
                "vendor",
                "source_revision"
              ]
            }
          }
        ]
      }
    }
  }
}
