    "@fastify/websocket": "^11.3.1",
    "argon2": "^0.45.1",
    "fastify": "^5.12.5",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/ws": "^8.18.0",
    "tsx": "^4.20.0",
