[sub_resource type="Shader" id="WaterShader"]
code = "shader_type spatial;\nrender_mode cull_disabled;\n\nuniform vec4 deep_color : source_color = vec4(0.015, 0.12, 0.20, 1.0);\nuniform vec4 shallow_color : source_color = vec4(0.05, 0.42, 0.50, 1.0);\nuniform float wave_scale = 0.035;\n\nvoid vertex() {\n    VERTEX.y += sin(VERTEX.x * 0.22 + TIME * 0.55) * wave_scale;\n    VERTEX.y += cos(VERTEX.z * 0.18 + TIME * 0.42) * wave_scale * 0.7;\n}\n\nvoid fragment() {\n    float bands = 0.5 + 0.5 * sin((UV.x + UV.y) * 32.0 + TIME * 0.35);\n    float foam = smoothstep(0.82, 0.98, bands) * 0.12;\n    ALBEDO = mix(deep_color.rgb, shallow_color.rgb, UV.y * 0.35 + foam);\n    ROUGHNESS = 0.2 + foam * 0.4;\n    METALLIC = 0.04;\n    SPECULAR = 0.7;\n    ALPHA = 0.88;\n}"

[sub_resource type="ShaderMaterial" id="WaterMaterial"]
