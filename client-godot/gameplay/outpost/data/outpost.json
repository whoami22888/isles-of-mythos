				"title": "Across the Strait",
				"lines": [
					[
						"First Mate",
						"Steady. Smoke on the far shore. That's their camp."
					]
				],
				"journal": "We crossed the strait under a patched sail. Smoke rose from a stockade on the northern isle."
			},
			"stockade": {
				"title": "The Stockade",
				"lines": [
					[
						"UTC Captain",
						"\"The Mythos mate! The Company pays double for you.\""
					],
					[
						"First Mate",
						"Then come and collect."
					]
				],
				"journal": "The UTC built a stockade on the beach and caged our men inside. Their captain knew my face."
			},
