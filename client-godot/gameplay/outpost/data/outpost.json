				"lines": [
					[
						"Silas",
						"\"A palisade and a forge? You've been busy.\""
					],
					[
						"Silas",
						"\"I'll drill the lads. Harpoons for the next raid.\""
					]
				],
				"journal": "Silas took the Barracks in hand. Two more bunks, and he is teaching the crew the harpoon."
			},
