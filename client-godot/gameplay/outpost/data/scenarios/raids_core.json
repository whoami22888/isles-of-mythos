{
 "scenarios": [
  {
   "id": "raid_night_sneak",
   "category": "raid",
   "title": "Shapes on the sand",
   "zones": [
    "any"
   ],
   "trigger": {
    "type": "action",
    "action": "night_no_watchtower",
    "chance": 0.55,
    "camp_level": 2
   },
   "weight": 3,
   "cooldown_s": 600,
   "intro_lines": [
    "No watch on the cliff tonight.",
    "Oars creak below the camp. Low voices. No lanterns."
   ],
   "choices": [
    {
     "label": "Grab the cutlass and meet them",
     "outcomes": [
      {
       "chance": 1,
       "text": "Three cutthroats creep up the beach toward the stash.",
       "effects": {
        "spawn": "raid:night_sneak"
       }
      }
     ]
    },
    {
     "label": "Douse the fire and hide the stash",
     "outcomes": [
      {
       "chance": 0.6,
       "text": "They poke about in the dark, curse, and row away with a sack of food.",
       "effects": {
        "items": {
         "food": -8
        },
        "morale": -5
       }
      },
      {
       "chance": 0.4,
       "text": "They find the stash anyway. Steel in the dark.",
       "effects": {
        "spawn": "raid:night_sneak"
       }
      }
     ]
    },
    {
     "label": "Send the pup to bark them off",
     "outcomes": [
      {
       "chance": 0.5,
       "text": "The pup's snarling sends them scrambling back to the boat.",
       "effects": {
        "pet_xp": 15,
        "morale": 5
       }
      },
      {
       "chance": 0.5,
       "text": "They laugh at the pup and come on.",
       "effects": {
        "spawn": "raid:night_sneak",
        "pet_xp": 8
       }
      }
     ],
     "requires": {
      "pet_level": 2
     }
    }
   ],
   "history_note": "Night raids on unwatched camps were the privateers' cheapest prize."
  },
  {
   "id": "raid_parley",
   "category": "raid",
   "title": "A white flag",
   "zones": [
    "beach",
    "camp"
   ],
   "trigger": {
    "type": "random",
    "chance": 0.6,
    "camp_level": 2,
    "rep_max": {
     "utc": 10
    }
   },
   "weight": 2,
   "cooldown_s": 900,
   "intro_lines": [
    "A UTC longboat rows in under a white flag.",
    "An officer calls for a parley on the sand."
   ],
   "choices": [
    {
     "label": "Walk down and hear him out",
     "outcomes": [
      {
       "chance": 0.45,
       "text": "It was a trap. Musketeers rise from the bilge.",
       "effects": {
        "spawn": "raid:ambush",
        "rep": {
         "utc": -5
        }
       }
      },
      {
       "chance": 0.35,
       "text": "He offers iron for your silence about the wreck.",
       "effects": {
        "items": {
         "iron": 12
        },
        "rep": {
         "utc": 5,
         "free": -3
        }
       }
      },
      {
       "chance": 0.2,
       "text": "He only wants water. He leaves you a bottle of rum.",
       "effects": {
        "items": {
         "rum": 1
        },
        "rep": {
         "utc": 3
        }
       }
      }
     ]
    },
    {
     "label": "Fire a warning shot",
     "outcomes": [
      {
       "chance": 0.6,
       "text": "They row off, cursing. They'll be back.",
       "effects": {
        "rep": {
         "utc": -8
        },
        "notoriety": 5
       }
      },
      {
       "chance": 0.4,
       "text": "They take it as war and storm the beach.",
       "effects": {
        "spawn": "raid:frontal",
        "rep": {
         "utc": -10
        }
       }
      }
     ],
     "requires": {
      "items": {
       "iron": 2
      }
     }
    },
    {
     "label": "Stay hidden in the treeline",
     "outcomes": [
      {
       "chance": 1,
       "text": "They wait an hour, then burn your drying rack out of spite.",
       "effects": {
        "items": {
         "food": -6
        },
        "morale": -4
       }
      }
     ]
    }
   ],
   "history_note": "Privateers used false flags of truce to lure out shore parties."
  },
